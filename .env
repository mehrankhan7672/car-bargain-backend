# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/car_bargain_saas

# For MongoDB Atlas (cloud) - use this if you have a cloud account
# MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/car_bargain_saas?retryWrites=true&w=majority

# JWT Configuration
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-please-use-a-long-secret-key
JWT_EXPIRE=7d

# CORS Configuration
FRONTEND_URL=http://localhost:8080

# File Upload Configuration
MAX_FILE_SIZE=5242880
UPLOAD_DIR=uploads/logos